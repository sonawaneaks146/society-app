rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.email == 'admin@society.app'; }

    // Loan requests: admin sees all; a member only their own document (id = member's Firebase uid)
    match /requests/{pid} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == pid);
    }

    // Password-reset requests: only the admin reads; a member writes only their own
    match /pwreq/{pid} {
      allow read: if isAdmin();
      allow write: if isAdmin() || (signedIn() && request.auth.uid == pid);
    }

    // Votes: everyone signed in reads; a member writes only their own vote document
    match /votes/{pid} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && request.auth.uid == pid);
    }

    // Logins: signed-in users read (password check); members may change member logins (password change/reset)
    match /auth/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && id != 'admin');
    }

    // Entries: collectors (members given the right in the app) also write.
    // NOTE: the "collector" right is enforced by the app; Firestore lets any signed-in user write tx.
    match /tx/{id} {
      allow read, write: if signedIn();
    }

    // Member information (profiles/photos): a signed-in member writes their own (the app only offers own-profile editing)
    match /profiles/{id} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // Anonymous poll ballots: anyone signed in may add one; nobody can change or delete it afterwards
    match /ballots/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Phone push tokens: a signed-in user saves/deletes their own; only the server (Cloud Function) reads them
    match /fcm/{id} {
      allow write: if signedIn();
      allow read: if false;
    }

    // Loan-request updates (everyone sees who asked / what the admin decided)
    match /loanfeed/{id} {
      allow read, write: if signedIn();
    }

    // Collections a member may be allowed to write by the admin inside the app (rights are enforced by the app)
    match /{col}/{id} {
      allow read: if signedIn() && col in ['members', 'invest', 'invtx', 'exp', 'bank', 'chg', 'polls', 'notices', 'perms', 'decisions', 'settings'];
      allow write: if signedIn() && col in ['members', 'invest', 'invtx', 'exp', 'bank', 'chg', 'polls', 'notices'];
    }

    // Admin-only writes
    match /{col}/{id} {
      allow write: if isAdmin() && col in ['perms', 'decisions', 'settings'];
    }
  }
}
